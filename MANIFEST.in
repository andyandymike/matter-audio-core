include LICENSE README.md README.zh-CN.md CONTRIBUTING.md SECURITY.md CHANGELOG.md
include mkdocs.yml requirements-docs.txt
recursive-include docs *.md
recursive-include docs/assets *.css *.svg
recursive-include examples *.py
recursive-include integrations *.md *.py *.example.json
recursive-include tests *.py
recursive-include tests *.cjs
recursive-include tools *.py
recursive-include src/matter_audio_core/web *.html *.css *.js
prune .local
prune .venv
prune spec
prune planning-private
prune workspaces
global-exclude *.py[cod] .env .env.* *.local.json *.wav *.ogg *.mp3 *.flac *.pem *.key *.sqlite* *.db *.db-*
